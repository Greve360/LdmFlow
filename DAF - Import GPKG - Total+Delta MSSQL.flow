        "DBMS": "MSSQL",
        "MaxParallelism": "\u00A4{MaxParallelism}\u00A4",
        "Mode": "Parallel",
        "ResultType": "Recordset",
        "Sql": "select entityname,\r\nfilename,\r\ngenerationnumber\r\nFROM [workflow].[DafFiles]\r\nwhere typeOfDownload = \u0027TotalDownload\u0027\r\nand version = \u00A4{DataVersion}\u00A4\r\nand Register = \u0027\u00A4{Register}\u00A4\u0027\r\nand (trim ( \u0027\u00A4{SingleTable}\u00A4\u0027) = entityname OR  len (trim ( \u0027\u00A4{SingleTable}\u00A4\u0027)) = 0)\r\nand generationnumber =((\r\n    select max(generationnumber)\r\n    from [workflow].[DafFiles]\r\n    where typeOfDownload = \u0027TotalDownload\u0027\r\n    and Register = \u0027\u00A4{Register}\u00A4\u0027\r\n    and version = \u00A4{DataVersion}\u00A4)) and entityname NOT LIKE \u0027%000%\u0027\r\norder by entityname;",
        "SqlTimeout": ""
      },
      "portPlacements": {
        "I:LoopBack": "Bottom"
      },
      "flippedPortSides": [
        "Bottom"
      ]
    },
