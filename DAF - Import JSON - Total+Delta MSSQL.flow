    {
      "id": "edf3a657-154f-4168-8f19-188330624d27",
      "name": "Iterate First Total",
      "category": "Module",
      "nodeType": "SqlIterator",
      "x": 1497.500000000001,
      "y": 32.9462426035513,
      "width": 190,
      "height": 92,
      "executionMode": "Enabled",
      "settings": {
        "ConnectionString": "\u00A4[DdmSysDb]\u00A4",
        "DBMS": "MSSQL",
        "MaxParallelism": "\u00A4{MaxParallelism}\u00A4",
        "Mode": "Parallel",
        "ResultType": "Recordset",
        "Sql": "select entityname,\r\nfilename,\r\ngenerationnumber,\r\nmd5Hash\r\nFROM [workflow].[DafFiles]\r\nwhere typeOfDownload = \u0027TotalDownload\u0027\r\n  and version = \u00A4{DataVersion}\u00A4\r\n  and Register = \u0027\u00A4{Register}\u00A4\u0027 \r\n  and containedFileFormat = \u0027\u00A4{ContainedFileFormat}\u00A4\u0027\r\n  and entityname NOT LIKE \u0027%000%\u0027\r\n  and generationnumber = ((\r\n    select max(generationnumber)\r\n    from [workflow].[DafFiles]\r\n    where typeOfDownload = \u0027TotalDownload\u0027\r\n        and containedFileFormat = \u0027\u00A4{ContainedFileFormat}\u00A4\u0027  \r\n        and Register = \u0027\u00A4{Register}\u00A4\u0027\r\n        and version = \u00A4{DataVersion}\u00A4\r\n        and entityname NOT LIKE \u0027%000%\u0027\r\n    ))  order by entityname;",
        "SqlTimeout": ""
      },
      "portPlacements": {
        "I:LoopBack": "Bottom"
      },
      "flippedPortSides": [
        "Bottom"
      ]
    },
