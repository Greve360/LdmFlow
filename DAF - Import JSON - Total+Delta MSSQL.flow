    {
      "id": "42a1808b-f83a-45ff-b4bf-b76309378642",
      "name": "Notify Claudi ;-)",
      "category": "Module",
      "nodeType": "ExecuteSQL",
      "x": 813,
      "y": 1009.8399999999888,
      "width": 200,
      "height": 102,
      "executionMode": "Enabled",
      "settings": {
        "CommandTimeout": "0",
        "ConnectionString": "\u00A4{ConnectionStringStaging}\u00A4",
        "DBMS": "MSSQL",
        "ExecuteEachLine": "False",
        "FilePath": "",
        "InTransaction": "False",
        "MaxRows": "0",
        "QueryType": "NonQuery",
        "ResultVariable": "",
        "SQL": "IF OBJECT_ID(N\u0027\u00A4{DafDbSchema}\u00A4.WorkflowGeneration\u0027, N\u0027U\u0027) IS NULL\nBEGIN\n    CREATE TABLE \u00A4{DafDbSchema}\u00A4.WorkflowGeneration\n    (\n        Generationsnummer int NOT NULL,\n        [timestamp] datetime2(7) NOT NULL\n            CONSTRAINT DF_WorkflowGeneration_Timestamp DEFAULT (SYSDATETIME()),\n\n        CONSTRAINT PK_WorkflowGeneration\n            PRIMARY KEY (generationsnummer)\n    );\nEND;\n\nINSERT INTO \u00A4{DafDbSchema}\u00A4.WorkflowGeneration (GenerationsNummer)\nVALUES (\u00A4{DafGeneration}\u00A4);"
      },
      "portPlacements": {},
      "flippedPortSides": []
    },
