      "settings": {
        "ConnectionString": "\u00A4{ConnectionString}\u00A4",
        "DBMS": "MSSQL",
        "FilePath": "",
        "QueryType": "NonQuery",
        "ResultVariable": "",
        "SQL": "IF NOT EXISTS (SELECT 1 FROM sys.schemas WHERE name = \u0027\u00A4{DafDbSchema,L}\u00A4\u0027)\r\n    EXEC(\u0027CREATE SCHEMA \u00A4{DafDbSchema,L}\u00A4\u0027);\r\n\r\nDROP TABLE IF EXISTS \u00A4{DafDbSchema,L}\u00A4.\u00A4{entityname,L}\u00A4;",
