    {
      "id": "3e561400-7966-4876-8ce9-b9180a1ea458",
      "name": "Stream SQL Bulk Copy",
      "category": "Module",
      "nodeType": "StreamSqlBulkCopy",
      "x": 266.5,
      "y": 870.5,
      "width": 316,
      "height": 119,
      "executionMode": "Enabled",
      "settings": {
        "BatchSize": "50000",
        "CreateTableIfMissing": "Yes",
        "DestinationConnectionString": "\u00A4{DestinationMSSQL}\u00A4",
        "DestinationTable": "\u00A4{DestinationSchema}\u00A4.\u00A4{tablename}\u00A4",
        "KeepNulls": "No",
        "RecreateTable": "Yes",
        "SourceConnectionString": "\u00A4[DafDataDB]\u00A4",
        "SourceDBMS": "Postgres",
        "SourceSql": "select \u00A4{SqlFields}\u00A4 from \u00A4{schemaname}\u00A4.\u00A4{tablename}\u00A4 \u00A4{RowLimiter}\u00A4;",
        "SqlTimeout": "0",
        "TargetTimeZone": "Romance Standard Time",
        "UtcToLocalColumns": "registreringfra, registreringtil, virkningfra, virkningtil"
      },
      "portPlacements": {
        "I:In": "Top"
      },
      "flippedPortSides": []
    },
    {
      "id": "3f1dd131-65c9-44f8-8435-7cf0e4ebd3e4",
      "name": "Get SQL Fields",
      "category": "Module",
      "nodeType": "GetSqlFields",
      "x": 350.5,
      "y": 258,
      "width": 200,
      "height": 102,
      "executionMode": "Enabled",
      "settings": {
        "ConnectionString": "\u00A4[DafDataDB]\u00A4",
        "DBMS": "Postgres",
        "GeometryOperations": "ST_MakeValid",
        "MakeGeometryBinary": "Yes",
        "Schema": "\u00A4{PostgresSchema}\u00A4",
        "Table": "\u00A4{tablename}\u00A4"
      },
      "portPlacements": {
        "I:In": "Top",
        "O:Out": "Bottom"
      },
      "flippedPortSides": []
    },
    {
      "id": "77252a7b-75b6-4083-9598-606e20ed8050",
      "name": "Loop PG Tables",
      "category": "Module",
      "nodeType": "SqlIterator",
      "x": 360.5,
      "y": 116,
      "width": 190,
      "height": 92,
      "executionMode": "Enabled",
      "settings": {
        "ConnectionString": "\u00A4[DafDataDB]\u00A4",
        "DBMS": "Postgres",
        "MaxParallelism": "10",
        "Mode": "Parallel",
        "ResultType": "Recordset",
        "Sql": "select schemaname, tablename from pg_tables where schemaname ilike \u0027\u00A4{PostgresSchema}\u00A4\u0027 order by tablename",
        "SqlTimeout": ""
      },
      "portPlacements": {
        "O:Item": "Bottom",
        "I:LoopBack": "Top"
      },
      "flippedPortSides": [
        "Top"
      ]
    },
    {
      "id": "a3ef69d6-db8e-49cd-9674-af6e1b0bb3ed",
      "name": "Display",
      "category": "Module",
      "nodeType": "Display",
      "x": 324.5,
      "y": 411,
      "width": 245,
      "height": 100,
      "executionMode": "Enabled",
      "settings": {
        "Text": "\u00A4{schemaname}\u00A4.\u00A4{tablename}\u00A4\r\n\u00A4{GeometryColumn}\u00A4"
      },
      "portPlacements": {
        "I:In": "Top",
        "O:Out": "Bottom"
      },
      "flippedPortSides": []
    },
    {
      "id": "383c259d-cbfa-4a0a-bad5-739b18071c18",
      "name": "Promote MSSQL Geometry",
