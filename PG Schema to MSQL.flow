      "nodeType": "PromoteMssqlGeometry",
      "x": 914,
      "y": 702,
      "width": 200,
      "height": 102,
      "executionMode": "Enabled",
      "settings": {
        "ConnectionString": "\u00A4{DestinationMSSQL}\u00A4",
        "CreateDestinationColumn": "Yes",
        "DestinationColumn": "geometri_ok",
        "DropSourceColumn": "Yes",
        "SourceColumn": "geometri",
        "SourceFormat": "WKB",
        "SpatialType": "Geometry",
        "SqlTimeout": "0",
        "SRID": "25832",
        "Table": "\u00A4{DestinationSchema}\u00A4.\u00A4{tablename}\u00A4",
        "WhereClause": ""
      },
      "portPlacements": {
        "O:Success": "Top"
      },
      "flippedPortSides": []
    },
    {
