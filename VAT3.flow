    {
      "id": "a5db89f4-4b77-4f7c-afa6-e72891a6e034",
      "name": "Indexes",
      "category": "Module",
      "nodeType": "ExecuteSQL",
      "x": 1091.3,
      "y": 616.9200000000001,
      "width": 200,
      "height": 102,
      "executionMode": "Enabled",
      "settings": {
        "CommandTimeout": "0",
        "ConnectionString": "\u00A4[DafDataDB]\u00A4",
        "DBMS": "Postgres",
        "ExecuteEachLine": "False",
        "FilePath": "",
        "InTransaction": "False",
        "MaxRows": "0",
        "QueryType": "NonQuery",
        "ResultVariable": "",
        "SQL": "CREATE INDEX IF NOT EXISTS idx_v3_adresse_geom     ON vat3.v3_adresse USING gist (geometri)     WITH (fillfactor=90, buffering=auto)     TABLESPACE pg_default;\r\n\r\nCREATE INDEX IF NOT EXISTS idx_v3_adressekoor     ON vat3.v3_adressekoor \r\n   USING btree     (husnr_lokalid, kommune ASC NULLS LAST, vejkode ASC NULLS LAST)\r\n    WITH (fillfactor=100, deduplicate_items=True)  TABLESPACE pg_default;\r\n\r\nCREATE INDEX IF NOT EXISTS idx_v3_vejmidte_geometri ON vat3.v3_vejmidte USING gist (geometri)  WITH (fillfactor=90, buffering=auto) TABLESPACE pg_default;\r\n\r\nCREATE INDEX IF NOT EXISTS idx_v3_vejnavn_geometri  ON vat3.v3_vejnavn USING gist  (geometri)  WITH (fillfactor=90, buffering=auto)  TABLESPACE pg_default;\r\n\r\nCREATE INDEX  IF NOT EXISTS v3_adresse_ins_search_postnr_partial_idx  ON vat3.v3_adresse (postnr)\r\n    WHERE geometri IS NOT NULL  AND vejnavn IS NOT NULL  AND husnummertekst IS NOT NULL;\r\n\r\nCREATE INDEX  IF NOT EXISTS v3_adresse_postnr_idx  ON vat3.v3_adresse (postnr);\r\n\r\nCREATE INDEX  IF NOT EXISTS v3_adresse_husnr_idx ON vat3.v3_adresse (husnummertekst);\r\n\r\nCREATE INDEX  IF NOT EXISTS v3_adresse_vejnavn_idx ON vat3.v3_adresse (vejnavn);\r\n"
      },
      "portPlacements": {
        "I:In": "Bottom",
        "O:Success": "Top",
        "O:Fail": "Left"
      },
      "flippedPortSides": [
        "Right"
      ]
    },
    {
      "id": "518f7476-f821-4eb6-a482-bb08b2458cf1",
      "name": "Anakyze",
      "category": "Module",
      "nodeType": "ExecuteSQL",
      "x": 1091.3,
      "y": 434.76000000000005,
      "width": 200,
      "height": 102,
      "executionMode": "Enabled",
      "settings": {
        "CommandTimeout": "0",
