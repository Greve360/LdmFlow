    {
      "id": "70315bc2-2cd3-4c9a-a46d-66865adaf2ec",
      "name": "V3 Postdistrikt ",
      "category": "Module",
      "nodeType": "ExecuteSQL",
      "x": 126.30000000000001,
      "y": 1593.44,
      "width": 249,
      "height": 92,
      "executionMode": "Enabled",
      "settings": {
        "CommandTimeout": "0",
        "ConnectionString": "\u00A4[DafDataDB]\u00A4",
        "DBMS": "Postgres",
        "ExecuteEachLine": "False",
        "FilePath": "",
        "InTransaction": "False",
        "MaxRows": "0",
        "QueryType": "NonQuery",
        "ResultVariable": "",
        "SQL": "drop table if exists vat3.v3_postdistrikt;\r\n\r\nCREATE TABLE vat3.v3_postdistrikt AS\r\nselect cast(kommunekode as integer) * 10000 \u002B cast(postnummer as integer) as id,\r\nkommunekode,\r\npostnummer,\r\nMAX(navn) as postdistrikt,\r\ncast(0.0 as float) as XKoor,\r\ncast(0.0 as float) as YKoor,\r\nST_RemoveRepeatedPoints(ST_Multi(ST_Union(geom))) AS geometri\r\nFROM(\r\n    SELECT k.kommunekode,\r\n    p.postnummer,\r\n    p.navn,\r\n    ST_Intersection(p.geometri, k.geometri) AS geom\r\n    FROM daf_dagi.postnummerinddeling p\r\n    JOIN daf_dagi.kommuneinddeling k ON ST_Intersects(p.geometri, k.geometri)) x\r\n    WHERE NOT ST_IsEmpty(geom)\r\n    GROUP BY kommunekode,\r\n    postnummer;\r\n    update vat3.v3_postdistrikt\r\n    set geometri = ST_MakeValid(geometri)\r\n    where not ST_IsValid(geometri);\r\n"
      },
      "portPlacements": {
        "I:In": "Top",
        "O:Success": "Bottom"
      },
      "flippedPortSides": [
        "Right"
      ]
    },
    {
