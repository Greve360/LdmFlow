    {
      "id": "d29c5d4c-c3d8-4d38-9980-9388a5142a90",
      "name": "V3 AdresseKoor",
      "category": "Module",
      "nodeType": "ExecuteSQL",
      "x": 126.30000000000001,
      "y": 1137.6493750000002,
      "width": 249,
      "height": 92,
      "executionMode": "Enabled",
      "settings": {
        "CommandTimeout": "0",
        "ConnectionString": "\u00A4[DafDataDB]\u00A4",
        "DBMS": "Postgres",
        "ExecuteEachLine": "False",
