      ]
    },
    {
      "id": "f8213d9b-db1e-4127-b3ff-cf3697ab34ea",
      "name": "V3 Postdistrikt Init",
      "category": "Module",
      "nodeType": "ExecuteSQL",
      "x": 126.30000000000001,
      "y": 1289.8400000000001,
      "width": 249,
      "height": 92,
      "executionMode": "Enabled",
      "settings": {
        "CommandTimeout": "0",
        "ConnectionString": "\u00A4[DafDataDB]\u00A4",
        "DBMS": "Postgres",
        "ExecuteEachLine": "False",
        "FilePath": "",
        "InTransaction": "False",
        "MaxRows": "0",
        "QueryType": "NonQuery",
        "ResultVariable": "",
        "SQL": "CREATE INDEX IF NOT EXISTS dagi_postnummerinddeling_geometri_gix ON daf_dagi.postnummerinddeling USING GIST(geometri);\r\nCREATE INDEX IF NOT EXISTS dagi_kommuneinddeling_geometri_gix ON daf_dagi.kommuneinddeling USING GIST(geometri);\r\nCREATE INDEX IF NOT EXISTS dagi_postnummerinddeling_postnummer_idx ON daf_dagi.postnummerinddeling(postnummer);\r\nCREATE INDEX IF NOT EXISTS dagi_kommuneinddeling_kommunekode_idx ON daf_dagi.kommuneinddeling(kommunekode);"
      },
      "portPlacements": {
        "I:In": "Top",
        "O:Success": "Bottom"
      },
      "flippedPortSides": [
        "Right"
      ]
    },
    {
      "id": "e982e10e-5ce1-40a9-83c0-9eaab320c28a",
      "name": "Analyze DAGI",
      "category": "Module",
      "nodeType": "ExecuteSQL",
      "x": 150.8,
      "y": 1436.64,
      "width": 200,
      "height": 102,
      "executionMode": "Enabled",
      "settings": {
