        "SQL": "vacuum analyze tmp.husnummer_new;\r\nvacuum analyze tmp.adressepunkt_new;\r\nvacuum analyze daf_dar.navngivenvej;\r\nvacuum analyze daf_dar.supplerendebynavn;\r\nvacuum analyze daf_dar.postnummer;"
      },
