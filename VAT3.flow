      "x": 1091.3,
      "y": 1163.4,
      "width": 200,
      "height": 102,
      "executionMode": "Enabled",
      "settings": {
        "CommandTimeout": "0",
        "ConnectionString": "\u00A4[DafDataDB]\u00A4",
        "DBMS": "Postgres",
        "ExecuteEachLine": "False",
        "FilePath": "",
        "InTransaction": "False",
        "MaxRows": "0",
        "QueryType": "NonQuery",
        "ResultVariable": "",
        "SQL": "    drop table if exists vat3.v3_vejnavn;\r\n    select  \r\n\t    vm.id_lokalid as id\r\n\t    , nvk.kommune \r\n\t    , vm.vejkode\r\n\t    , nv.vejnavn \r\n\t    , vm.geometri\r\n    into \r\n\t    vat3.v3_vejnavn\r\n    from \r\n\t    daf_gdk.vejmidte vm\r\n    left outer join \r\n\t    daf_dar.navngivenvejkommunedel nvk  on nvk.kommune::int4 = vm.kommunekode::int4  and nvk.vejkode::int4 = vm.vejkode::int4  and nvk.registreringtil is null and nvk.virkningtil is null\r\n    left outer join \r\n\t    daf_dar.navngivenvej nv  on nv.id_lokalid  = nvk.navngivenvej and nv.registreringtil is null and nv.virkningtil is null\r\n    where vm.registreringtil is null and vm.virkningtil is null;"
      },
      "portPlacements": {
        "I:In": "Bottom",
        "O:Success": "Top",
        "O:Fail": "Left"
      },
      "flippedPortSides": [
        "Right"
      ]
    },
    {
      "id": "71a2dbd3-916c-4e6a-9ce0-3c0029f0da9b",
      "name": "V3 Vejmidte",
      "category": "Module",
      "nodeType": "ExecuteSQL",
      "x": 1091.3,
      "y": 981.24,
      "width": 200,
      "height": 102,
      "executionMode": "Enabled",
      "settings": {
        "CommandTimeout": "0",
        "ConnectionString": "\u00A4[DafDataDB]\u00A4",
        "DBMS": "Postgres",
        "ExecuteEachLine": "False",
        "FilePath": "",
        "InTransaction": "False",
        "MaxRows": "0",
        "QueryType": "NonQuery",
        "ResultVariable": "",
        "SQL": "drop table if exists vat3.v3_vejmidte;\t\r\n\r\n;with cte as (\r\nselect  \r\n    id_lokalid as id\r\n    , vejkode\r\n    , status\r\n    , vejkategori\r\n    , trafikart\r\n    , overflade\r\n    , vejmidtetype \r\n    , vejmyndighed \r\n    , tilogfrakoersel  --  bool \r\n    , rundkoersel -- bool \r\n    , niveau\t\r\n    , geometri\r\n\t, kommunekode\r\nfrom\r\n    daf_gdk.vejmidte \r\nwhere registreringtil is null and virkningtil is null)\r\nselect \r\n\tid \r\n    , nvk.kommune \r\n    , cte.vejkode\r\n    , nv.vejnavn \r\n    , cte.status\r\n    , cte.vejkategori\r\n    , cte.trafikart\r\n    , cte.overflade\r\n    , cte.vejmidtetype \r\n    , cte.vejmyndighed \r\n    , cte.tilogfrakoersel  --  bool \r\n    , cte.rundkoersel -- bool \r\n    , cte.niveau\t\r\n    , cast (0 as int4) as vejkategori_enum\r\n    , cast (0 as int4) as trafikart_enum\r\n    , cast (0 as int4) as overflade_enum\r\n    , cast (0 as int4) as niveau_enum\r\n    , cast (0 as int4) as status_enum\r\n    , cast (0.0 as decimal(18,3)) as offset_x\r\n    , cast (0.0 as decimal(18,3)) as offset_y \r\n    , \u0027GeoDK6.Vejmidte\u0027 as orgtabel\r\n    , cte.geometri\r\ninto \r\n    vat3.v3_vejmidte\r\nfrom cte \t\r\nleft outer join \r\n    daf_dar.navngivenvejkommunedel nvk  on nvk.kommune::int4 = cte.kommunekode::int4  and nvk.vejkode::int4 = cte.vejkode::int4   and nvk.registreringtil is null and nvk.virkningtil is null\r\nleft outer join \r\n    daf_dar.navngivenvej nv  on nv.id_lokalid  = nvk.navngivenvej and nv.registreringtil is null and nv.virkningtil is null;\r\n    "
      },
      "portPlacements": {
        "I:In": "Bottom",
        "O:Success": "Top",
        "O:Fail": "Left"
      },
      "flippedPortSides": [
        "Right"
      ]
    },
    {
      "id": "52f459b9-a99e-4b6c-bff3-55da7669eaa8",
      "name": "V3 Vejmidte ENUM",
      "category": "Module",
      "nodeType": "ExecuteSQL",
      "x": 1091.3,
      "y": 799.08,
      "width": 200,
      "height": 102,
      "executionMode": "Enabled",
      "settings": {
        "CommandTimeout": "0",
        "ConnectionString": "\u00A4[DafDataDB]\u00A4",
        "DBMS": "Postgres",
        "ExecuteEachLine": "False",
        "FilePath": "",
        "InTransaction": "False",
        "MaxRows": "0",
        "QueryType": "NonQuery",
        "ResultVariable": "",
        "SQL": ";with cte as (select distinct vejkategori from vat3.v3_vejmidte where vejkategori not in (select value from vat3.enum_vejnavnkoor where feltnavn=\u0027vejkategori\u0027) )\r\n    INSERT INTO vat3.enum_vejnavnkoor (feltnavn, value) select \u0027vejkategori\u0027, vejkategori from cte \r\n\r\n    ;with cte as (\r\n\t    select distinct trafikart from vat3.v3_vejmidte  where trafikart not in (select value from vat3.enum_vejnavnkoor where feltnavn=\u0027trafikart\u0027) )\r\n    INSERT INTO vat3.enum_vejnavnkoor (\u0022feltnavn\u0022, \u0022value\u0022) select \u0027trafikart\u0027, trafikart from cte \r\n\r\n    ;with cte as (\r\n\t    select distinct overflade from vat3.v3_vejmidte  where overflade not in (select value from vat3.enum_vejnavnkoor where feltnavn=\u0027overflade\u0027) )\r\n    INSERT INTO vat3.enum_vejnavnkoor (\u0022feltnavn\u0022, \u0022value\u0022) select \u0027overflade\u0027, overflade from cte \r\n\r\n    ;with cte as (\r\n\t    select distinct niveau from vat3.v3_vejmidte  where niveau not in (select value from vat3.enum_vejnavnkoor where feltnavn=\u0027niveau\u0027) )\r\n    INSERT INTO vat3.enum_vejnavnkoor (\u0022feltnavn\u0022, \u0022value\u0022) select \u0027niveau\u0027, niveau from cte \r\n\r\n    ;with cte as (\r\n\t    select distinct status from vat3.v3_vejmidte  where status not in (select value from vat3.enum_vejnavnkoor where feltnavn=\u0027status\u0027) )\r\n    INSERT INTO vat3.enum_vejnavnkoor (\u0022feltnavn\u0022, \u0022value\u0022) select \u0027status\u0027, status from cte ;\r\n\r\nUPDATE vat3.v3_vejmidte v SET vejkategori_enum = ev.kode FROM vat3.enum_vejnavnkoor ev WHERE ev.feltnavn=\u0027vejkategori\u0027 and LOWER(ev.value) = LOWER(v.vejkategori);\r\nUPDATE vat3.v3_vejmidte v SET trafikart_enum = ev.kode   FROM vat3.enum_vejnavnkoor ev WHERE ev.feltnavn=\u0027trafikart\u0027   and LOWER(ev.value) = LOWER(v.trafikart);\r\nUPDATE vat3.v3_vejmidte v SET overflade_enum = ev.kode   FROM vat3.enum_vejnavnkoor ev WHERE ev.feltnavn=\u0027overflade\u0027   and LOWER(ev.value) = LOWER(v.overflade);\r\nUPDATE vat3.v3_vejmidte v SET niveau_enum = ev.kode      FROM vat3.enum_vejnavnkoor ev WHERE ev.feltnavn=\u0027niveau\u0027      and LOWER(ev.value) = LOWER(v.niveau);\r\nUPDATE vat3.v3_vejmidte v SET status_enum = ev.kode      FROM vat3.enum_vejnavnkoor ev WHERE ev.feltnavn=\u0027status\u0027      and LOWER(ev.value) = LOWER(v.status);\r\n"
      },
      "portPlacements": {
        "I:In": "Bottom",
        "O:Success": "Top",
        "O:Fail": "Left"
      },
      "flippedPortSides": [
        "Right"
      ]
