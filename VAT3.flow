    {
      "id": "4fbc672a-424f-4d37-9dad-2f73d9e0e3a4",
      "name": "TMP Vejsegment",
      "category": "Module",
      "nodeType": "ExecuteSQL",
      "x": 150.8,
      "y": 374.04,
      "width": 200,
      "height": 102,
      "executionMode": "Enabled",
      "settings": {
        "CommandTimeout": "0",
        "ConnectionString": "\u00A4[DafDataDB]\u00A4",
        "DBMS": "Postgres",
        "ExecuteEachLine": "False",
        "FilePath": "",
        "InTransaction": "False",
        "MaxRows": "0",
        "QueryType": "NonQuery",
        "ResultVariable": "",
        "SQL": "DROP TABLE IF EXISTS tmp.vejsegment;\r\nCREATE UNLOGGED TABLE tmp.vejsegment AS\r\n    SELECT \r\n     t.fid, t.id_namespace, t.id_lokalid, t.status, t.geometristatus, t.registreringsspecifikation, t.dataansvar, t.forretningshaendelse, \r\n     t.forretningsomraade, t.registreringsaktoer, t.registreringfra, t.registreringtil, t.virkningsaktoer, t.virkningfra, t.virkningtil, t.plannoejagtighed, t.planstedfaestelsesmetode, \r\n     t.vertikalnoejagtighed, t.vertikalstedfaestelsesmetode, t.applikation, t.vejmidtetype, t.vejmyndighed, t.cvfadmnr, t.kommunekode, t.vejkode, t.vejkategori, t.trafikart, t.overflade, \r\n     t.tilogfrakoersel, t.rundkoersel, t.kommentar, t.forretningsproces, t.tempid, t.niveau, dmp.geom AS linesegment\r\n    FROM\r\n        daf_gdk.vejmidte t,\r\n        LATERAL ST_Dump(t.geometri) AS dmp\r\n    where\r\n        lower (t.vejmidtetype)=\u0027vej\u0027\r\n        and t.geometri IS NOT null\r\n        and t.registreringtil is null \r\n        and t.virkningtil     is null;\r\n\r\n CREATE INDEX vejsegment_geometri_idx ON tmp.vejsegment using gist (linesegment);\r\n"
      },
      "portPlacements": {
        "I:In": "Top",
        "O:Success": "Bottom"
      },
      "flippedPortSides": [
        "Right"
      ]
    },
    {
      "id": "fe983b13-9f48-4e01-aab9-133857460d19",
      "name": "TMP Adresse \u0026 Husnummer",
      "category": "Module",
      "nodeType": "ExecuteSQL",
      "x": 126.30000000000001,
      "y": 682.6400000000001,
      "width": 249,
      "height": 92,
      "executionMode": "Enabled",
      "settings": {
        "CommandTimeout": "0",
        "ConnectionString": "\u00A4[DafDataDB]\u00A4",
        "DBMS": "Postgres",
        "ExecuteEachLine": "False",
        "FilePath": "",
        "InTransaction": "False",
        "MaxRows": "0",
        "QueryType": "NonQuery",
        "ResultVariable": "",
        "SQL": "drop table if exists tmp.adressepunkt_new; \r\nCREATE UNLOGGED TABLE tmp.adressepunkt_new as SELECT *, ST_GeomFromText(position, 25832)::geometry(Point, 25832) AS position_geom FROM daf_dar.adressepunkt where registreringtil is null and virkningtil is null;\r\n\r\ndrop table if exists tmp.husnummer_new; \r\nCREATE UNLOGGED TABLE tmp.husnummer_new as SELECT *, ST_GeomFromText(husnummerretning, 25832)::geometry(Point, 25832) AS husnummerretning_geom FROM daf_dar.husnummer;\r\n\r\nCREATE INDEX husnummer_new_aktive_idx ON tmp.husnummer_new (navngivenvej, postnummer, adgangspunkt, supplerendebynavn) WHERE registreringtil IS NULL AND virkningtil IS NULL;\r\n\r\nCREATE INDEX husnummer_new_id_lokalid_aktive_idx\r\nON tmp.husnummer_new (id_lokalid)\r\nWHERE registreringtil IS NULL\r\n  AND virkningtil IS NULL;\r\n\r\nCREATE INDEX adressepunkt_new_id_lokalid_aktive_idx\r\nON tmp.adressepunkt_new (id_lokalid)\r\nWHERE registreringtil IS NULL\r\n  AND virkningtil IS NULL;\r\n\r\nCREATE INDEX if not exists navngivenvej_id_lokalid_aktive_idx\r\nON daf_dar.navngivenvej (id_lokalid)\r\nWHERE registreringtil IS NULL\r\n  AND virkningtil IS NULL;\r\n\r\nCREATE INDEX if not exists postnummer_id_lokalid_aktive_idx\r\nON daf_dar.postnummer (id_lokalid)\r\nWHERE registreringtil IS NULL\r\n  AND virkningtil IS NULL;\r\n\r\nCREATE INDEX if not exists supplerendebynavn_id_lokalid_aktive_idx\r\nON daf_dar.supplerendebynavn (id_lokalid)\r\nWHERE registreringtil IS NULL\r\n  AND virkningtil IS NULL;\r\n"
      },
      "portPlacements": {
        "I:In": "Top",
        "O:Success": "Bottom"
      },
      "flippedPortSides": [
        "Right"
      ]
    },
    {
      "id": "0b20b7a5-5615-4ede-8600-cabe0ea5fc53",
      "name": "Update POST",
      "category": "Module",
      "nodeType": "ExecuteSQL",
      "x": 589.7,
      "y": 1952.7600000000002,
      "width": 200,
      "height": 102,
      "executionMode": "Enabled",
      "settings": {
        "CommandTimeout": "0",
        "ConnectionString": "\u00A4[DafDataDB]\u00A4",
        "DBMS": "Postgres",
        "ExecuteEachLine": "False",
        "FilePath": "",
        "InTransaction": "False",
        "MaxRows": "0",
        "QueryType": "NonQuery",
        "ResultVariable": "",
        "SQL": "UPDATE vat3.v3_postdistrikt p\r\nset XKoor = round(ST_X(m.center) ::numeric, 3),\r\nYKoor = round(ST_Y(m.center) ::numeric, 3)\r\nFROM(\r\n    select id,\r\n    (ST_MaximumInscribedCircle(geometri)).center AS center\r\n    FROM vat3.v3_postdistrikt) m\r\n    WHERE p.id = m.id;\r\n    delete from vat3.v3_postdistrikt\r\n    where ST_GeometryType(geometri) in(\u0027ST_MultiLineString\u0027, \u0027ST_LineString\u0027, \u0027ST_MultiPoint\u0027, \u0027ST_Point\u0027);\r\n\r\nupdate vat3.v3_postdistrikt   set geometri = ST_Multi(ST_CollectionExtract(geometri, 3))    where ST_GeometryType(geometri) = \u0027ST_GeometryCollection\u0027;\r\nupdate vat3.v3_postdistrikt    set geometri = ST_Multi(ST_Buffer(ST_Buffer(geometri, 0.1), - 0.1));\r\nupdate vat3.v3_postdistrikt    set geometri = ST_Multi(ST_Buffer(ST_Buffer(geometri, - 0.05), 0.05));\r\nupdate vat3.v3_postdistrikt    set geometri = ST_Normalize(geometri);\r\nupdate vat3.v3_postdistrikt    set geometri = ST_Simplify(geometri, 0.05);\r\nupdate vat3.v3_postdistrikt    set geometri = ST_Multi(geometri);"
      },
      "portPlacements": {},
      "flippedPortSides": [
        "Right"
      ]
    },
    {
      "id": "e3d8295a-3d48-47b8-8224-73e527ae44d9",
      "name": "V3 Adresse ",
      "category": "Module",
      "nodeType": "ExecuteSQL",
      "x": 126.30000000000001,
      "y": 986.24,
      "width": 249,
      "height": 92,
      "executionMode": "Enabled",
      "settings": {
        "CommandTimeout": "0",
        "ConnectionString": "\u00A4[DafDataDB]\u00A4",
        "DBMS": "Postgres",
        "ExecuteEachLine": "False",
        "FilePath": "",
        "InTransaction": "False",
        "MaxRows": "0",
        "QueryType": "NonQuery",
        "ResultVariable": "",
        "SQL": "drop table if exists vat3.v3_adresse;\r\nselect  \r\n    hn.id_lokalid as husnr_lokalid\r\n    , hn.adgangsadressebetegnelse\r\n    , nv.vejnavn \r\n    , substring (hn.vejmidte || \u0027000000000\u0027, 1, 4)::int4 as kommune\r\n    , substring (hn.vejmidte || \u0027000000000\u0027, 6, 4)::int4 as vejkode\r\n    , hn.husnummertekst  \r\n    , pn.postnr \r\n    , pn.navn as postdistrikt\r\n    , sbn.navn as supplerendebynavn\r\n    , 5::int2 as placering\r\n    , hn.jordstykke as jordstykke_lokalid\r\n    , js.ejerlavlokalid\r\n    , js.matrikelnummer\r\n\t, ap.oprindelse_kilde\r\n\t, ap.oprindelse_noejagtighedsklasse as oprindelse_noejagtighedsklasse\r\n\t, ap.oprindelse_registrering\r\n\t, ap.oprindelse_tekniskstandard\t    \r\n\t, ap.registreringfra as adr_registreringfra\r\n\t, ap.virkningfra as adr_virkningfra\r\n\t, ap.id_lokalid as adressepunkt\r\n\t, hn.vejpunkt\r\n\t, hn.adgangspunkt \r\n\t, hn.placeretpaaforeloebigtjordstykke as placeretpaaforeloebigtjordstykke\r\n\t, hn.geodanmarkbygning\r\n\t, hn.adgangtilbygning\r\n\t, hn.adgangtiltekniskanlaeg as adgangtiltekniskanlaeg\r\n\t, hn.vejmidte\r\n\t, hn.afstemningsomraade as afstemningsomraade\r\n\t, hn.menighedsraadsafstemningsomraade as menighedsraadsafstemningsomraade\r\n\t, hn.sogneinddeling\r\n\t, hn.navngivenvej\t\t\r\n    , ap.position_geom as geometri\r\n    , degrees(atan2(ST_Y(husnummerretning_geom), ST_X(husnummerretning_geom))) AS angle_raw\r\n    , fmod ((degrees(atan2(ST_Y(husnummerretning_geom), ST_X(husnummerretning_geom))) \u002B 360.0), 360.0) AS angle_deg\r\n    , 0.0::float8 as angle_gon\r\ninto \r\n    vat3.v3_adresse\r\nfrom \r\n    tmp.adressepunkt_new ap\r\ninner join \r\n    tmp.husnummer_new hn on ap.id_lokalid  = hn.adgangspunkt and hn.registreringtil is null and hn.virkningtil is null\r\nleft outer join \r\n    daf_mat.jordstykke js on hn.jordstykke = js.id_lokalid and js.registreringtil is null and js.virkningtil is null and js.status = \u0027G\u00E6ldende\u0027\r\nleft outer join \r\n    daf_dar.navngivenvej nv on nv.id_lokalid = hn.navngivenvej and nv.registreringtil is null and nv.virkningtil is null\r\nleft outer join \r\n    daf_dar.postnummer pn on hn.postnummer = pn.id_lokalid and pn.registreringtil is null and pn.virkningtil is null\r\nleft outer join \r\n    daf_dar.supplerendebynavn sbn on sbn.id_lokalid  = hn.supplerendebynavn  and sbn.registreringtil is null and sbn.virkningtil is null\r\nwhere ap.registreringtil is null and ap.virkningtil is null and ap.oprindelse_tekniskstandard in (\u0027TA\u0027,\u0027TD\u0027,\u0027TK\u0027,\u0027TN\u0027,\u0027UF\u0027);\r\n\r\nupdate vat3.v3_adresse set angle_gon = 400.0 / 360.0 * angle_deg;  \r\n"
      },
      "portPlacements": {
        "I:In": "Top",
        "O:Success": "Bottom"
      },
      "flippedPortSides": [
        "Right"
      ]
    },
    {
      "id": "4e971e5a-13c1-4e93-919d-1313800098f4",
