    {
      "id": "1988163a-358e-485a-9c75-a5d579e412cf",
      "name": "V3 ENUM VejnavnKoor",
      "category": "Module",
      "nodeType": "ExecuteSQL",
      "x": 1091.3,
      "y": 1315.2,
      "width": 200,
      "height": 102,
      "executionMode": "Enabled",
      "settings": {
        "CommandTimeout": "0",
        "ConnectionString": "\u00A4[DafDataDB]\u00A4",
        "DBMS": "Postgres",
        "ExecuteEachLine": "False",
        "FilePath": "",
        "InTransaction": "False",
        "MaxRows": "0",
        "QueryType": "NonQuery",
        "ResultVariable": "",
        "SQL": "CREATE SEQUENCE if not exists vat3.enum_kode\r\n        START 1\r\n        INCREMENT 1\r\n        MINVALUE 1\r\n        NO MAXVALUE\r\n        CACHE 1;\r\n\r\nCREATE TABLE if not exists vat3.enum_vejnavnkoor (\r\n        feltnavn varchar(50) NOT NULL,\r\n        kode smallint NOT NULL DEFAULT nextval(\u0027vat3.enum_kode\u0027),\r\n        value varchar(50) NULL,\r\n        CONSTRAINT pk_enum_vejnavn PRIMARY KEY (feltnavn, kode)\r\n        );\r\n\r\n;with cte as (\r\n    select distinct vejkategori from vat3.v3_vejnavnkoor  where vejkategori not in (select value from vat3.enum_vejnavnkoor where feltnavn=\u0027vejkategori\u0027) )\r\nINSERT INTO vat3.enum_vejnavnkoor (\u0022feltnavn\u0022, \u0022value\u0022) select \u0027vejkategori\u0027, vejkategori from cte;\r\n\r\n;with cte as (\r\n    select distinct trafikart from vat3.v3_vejnavnkoor  where trafikart not in (select value from vat3.enum_vejnavnkoor where feltnavn=\u0027trafikart\u0027) )\r\nINSERT INTO vat3.enum_vejnavnkoor (\u0022feltnavn\u0022, \u0022value\u0022) select \u0027trafikart\u0027, trafikart from cte;\r\n\r\n;with cte as (\r\n    select distinct overflade from vat3.v3_vejnavnkoor  where overflade not in (select value from vat3.enum_vejnavnkoor where feltnavn=\u0027overflade\u0027) )\r\nINSERT INTO vat3.enum_vejnavnkoor (\u0022feltnavn\u0022, \u0022value\u0022) select \u0027overflade\u0027, overflade from cte;\r\n\r\n;with cte as (\r\n    select distinct niveau from vat3.v3_vejnavnkoor  where niveau not in (select value from vat3.enum_vejnavnkoor where feltnavn=\u0027niveau\u0027) )\r\nINSERT INTO vat3.enum_vejnavnkoor (\u0022feltnavn\u0022, \u0022value\u0022) select \u0027niveau\u0027, niveau from cte;\r\n\r\n;with cte as (\r\n    select distinct status from vat3.v3_vejnavnkoor  where status not in (select value from vat3.enum_vejnavnkoor where feltnavn=\u0027status\u0027) )\r\nINSERT INTO vat3.enum_vejnavnkoor (\u0022feltnavn\u0022, \u0022value\u0022) select \u0027status\u0027, status from cte ;\r\n\r\nUPDATE vat3.v3_vejnavnkoor v SET vejkategori_enum = ev.kode FROM vat3.enum_vejnavnkoor ev WHERE ev.feltnavn=\u0027vejkategori\u0027 and LOWER(ev.value) = LOWER(v.vejkategori);\r\nUPDATE vat3.v3_vejnavnkoor v SET trafikart_enum = ev.kode   FROM vat3.enum_vejnavnkoor ev WHERE ev.feltnavn=\u0027trafikart\u0027   and LOWER(ev.value) = LOWER(v.trafikart);\r\nUPDATE vat3.v3_vejnavnkoor v SET overflade_enum = ev.kode   FROM vat3.enum_vejnavnkoor ev WHERE ev.feltnavn=\u0027overflaide\u0027  and LOWER(ev.value) = LOWER(v.overflade);\r\nUPDATE vat3.v3_vejnavnkoor v SET niveau_enum = ev.kode      FROM vat3.enum_vejnavnkoor ev WHERE ev.feltnavn=\u0027niveau\u0027      and LOWER(ev.value) = LOWER(v.niveau);\r\nUPDATE vat3.v3_vejnavnkoor v SET status_enum = ev.kode      FROM vat3.enum_vejnavnkoor ev WHERE ev.feltnavn=\u0027status\u0027      and LOWER(ev.value) = LOWER(v.status);\r\n\r\n"
      },
      "portPlacements": {
        "I:In": "Bottom",
        "O:Success": "Top",
        "O:Fail": "Left"
      },
      "flippedPortSides": [
        "Right"
      ]
    },
    {
      "id": "24079265-8eeb-4515-8dfc-f227a00abe73",
      "name": "V3 Vejnavn",
      "category": "Module",
