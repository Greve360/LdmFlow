        "InTransaction": "False",
        "MaxRows": "0",
        "QueryType": "NonQuery",
        "ResultVariable": "",
        "SQL": "drop table if exists vat3.v3_adressekoor;\r\n    select  \r\n\t    husnr_lokalid\r\n\t    , kommune\r\n\t    , vejkode\r\n\t    , ST_X(geometri)\r\n\t    , ST_Y(geometri)\r\n    into \r\n\t    vat3.v3_adressekoor\r\n    from \r\n\t    vat3.v3_adresse"
      },
      "portPlacements": {
