    {
      "id": "c27bc3be-1b2e-4ab0-9a00-0c0e7f7fc140",
      "name": "Update POST",
      "category": "Module",
      "nodeType": "ExecuteSQL",
      "x": 903.2,
      "y": 1922.4,
      "width": 200,
      "height": 102,
      "executionMode": "Enabled",
      "settings": {
        "CommandTimeout": "0",
        "ConnectionString": "\u00A4[DafDataDB]\u00A4",
        "DBMS": "Postgres",
        "ExecuteEachLine": "False",
        "FilePath": "",
        "InTransaction": "False",
        "MaxRows": "0",
        "QueryType": "NonQuery",
        "ResultVariable": "",
        "SQL": "UPDATE vat3.v3_postdistrikt p\r\nset XKoor = round(ST_X(m.center) ::numeric, 3),\r\nYKoor = round(ST_Y(m.center) ::numeric, 3)\r\nFROM(\r\n    select id,\r\n    (ST_MaximumInscribedCircle(geometri)).center AS center\r\n    FROM vat3.v3_postdistrikt) m\r\n    WHERE p.id = m.id;\r\n    delete from vat3.v3_postdistrikt\r\n    where ST_GeometryType(geometri) in(\u0027ST_MultiLineString\u0027, \u0027ST_LineString\u0027, \u0027ST_MultiPoint\u0027, \u0027ST_Point\u0027);\r\n\r\nupdate vat3.v3_postdistrikt   set geometri = ST_Multi(ST_CollectionExtract(geometri, 3))    where ST_GeometryType(geometri) = \u0027ST_GeometryCollection\u0027;\r\nupdate vat3.v3_postdistrikt    set geometri = ST_Multi(ST_Buffer(ST_Buffer(geometri, 0.1), - 0.1));\r\nupdate vat3.v3_postdistrikt    set geometri = ST_Multi(ST_Buffer(ST_Buffer(geometri, - 0.05), 0.05));\r\nupdate vat3.v3_postdistrikt    set geometri = ST_Normalize(geometri);\r\nupdate vat3.v3_postdistrikt    set geometri = ST_Simplify(geometri, 0.05);\r\nupdate vat3.v3_postdistrikt    set geometri = ST_Multi(geometri);"
      },
      "portPlacements": {
        "O:Fail": "Top"
      },
      "flippedPortSides": [
        "Right"
      ]
    },
    {
      "id": "e38478d2-c72b-44d7-94c1-f8474ba3b872",
      "name": "V3 VejnavnKoor",
      "category": "Module",
      "nodeType": "ExecuteSQL",
      "x": 1091.3,
      "y": 1679.5200000000002,
      "width": 200,
      "height": 102,
      "executionMode": "Enabled",
      "settings": {
        "CommandTimeout": "0",
        "ConnectionString": "\u00A4[DafDataDB]\u00A4",
        "DBMS": "Postgres",
        "ExecuteEachLine": "False",
        "FilePath": "",
        "InTransaction": "False",
        "MaxRows": "0",
        "QueryType": "NonQuery",
        "ResultVariable": "",
        "SQL": "CREATE SEQUENCE if not exists vat3.vejnavn_id\r\n        START 1\r\n        INCREMENT 1\r\n        MINVALUE 1\r\n        NO MAXVALUE\r\n        CACHE 1;\r\n\r\ndrop table if exists vat3.v3_vejnavnkoor;\t\r\n\r\nselect  \r\n    nextval(\u0027vat3.vejnavn_id\u0027) as id  \r\n    , vs.id_lokalid as vejsegment_lokalid\r\n    , nvk.kommune \r\n    , vs.vejkode\r\n    , nv.vejnavn \r\n    , vs.status\r\n    , vs.vejkategori\r\n    , vs.trafikart\r\n    , vs.overflade\r\n    , vs.tilogfrakoersel  --  bool \r\n    , vs.rundkoersel -- bool \r\n    , vs.niveau\t\r\n    , vs.linesegment\r\n    , cast (0 as int4) as vejkategori_enum\r\n    , cast (0 as int4) as trafikart_enum\r\n    , cast (0 as int4) as overflade_enum\r\n    , cast (0 as int4) as niveau_enum\r\n    , cast (0 as int4) as status_enum\r\n    , cast (0.0 as decimal(18,3)) as offset_x\r\n    , cast (0.0 as decimal(18,3)) as offset_y \r\n    , \u0027GeoDK6.Vejmidte\u0027 as orgtabel\r\n    , ST_Force2D(ST_LineInterpolatePoint (linesegment, 0.5)) as label\r\n    , 0.0::float8 AS angle_raw\r\n    , 0.0::float8 AS angle_deg\r\n    , 0.0::float8 AS angle_gon\r\n    , ST_Length (vs.linesegment) as len\r\ninto \r\n    vat3.v3_vejnavnkoor\r\nfrom \r\n    tmp.vejsegment vs\r\nleft outer join \r\n    daf_dar.navngivenvejkommunedel nvk  on nvk.kommune::int4 = vs.kommunekode::int4  and nvk.vejkode::int4 = vs.vejkode::int4  and nvk.registreringtil is null and nvk.virkningtil is null\r\nleft outer join \r\n    daf_dar.navngivenvej nv  on nv.id_lokalid  = nvk.navngivenvej and nv.registreringtil is null and nv.virkningtil is null\r\nwhere\r\n    ST_Length (vs.linesegment) \u003E 40.0   -- Dont label small linesegments\r\n    and nv.vejnavn is not null;          -- No need to render \u0022invisible\u0022 adresses\r\n\r\n;WITH segments AS (\r\n      SELECT\r\n        id,\r\n        ST_PointN(v.linesegment, gs)   AS p1,\r\n        ST_PointN(v.linesegment, gs\u002B1) AS p2,\r\n        v.label\r\n      FROM vat3.v3_vejnavnkoor v\r\n      CROSS JOIN generate_series(1, ST_NPoints(v.linesegment)-1) gs\r\n    ),\r\n    hit AS (\r\n      SELECT distinct on (s.id)\r\n  \t    s.id, s.p1, s.p2\r\n      FROM segments s\r\n      WHERE ST_DWithin(ST_MakeLine(s.p1,s.p2), s.label, 1e-6) -- label lies on this segment\r\n    )\r\n    update vat3.v3_vejnavnkoor vn\r\n    set angle_deg = cast (180 - (degrees(atan2(ST_Y(p2)-ST_Y(p1), ST_X(p2)-ST_X(p1)))) as int4) % 360\r\n       ,angle_raw = fmod(((pi()/2 - ST_Azimuth(p1, p2)) \u002B 2*pi()), 2*pi()) \r\n    FROM hit h\r\n    WHERE vn.id = h.id;\r\n\r\nupdate vat3.v3_vejnavnkoor set angle_gon = 400.0 / 360.0 * angle_deg;\r\nupdate vat3.v3_vejnavnkoor set offset_x = 1*cos(angle_raw \u002B 0.5*PI()), offset_y = 1.0*sin(angle_raw \u002B 0.5*PI()) where angle_raw between 0 and PI()/2;        -- Q1\r\nupdate vat3.v3_vejnavnkoor set offset_x = -1*cos(angle_raw \u002B 0.5*PI()), offset_y = -1.0*sin(angle_raw \u002B 0.5*PI()) where angle_raw between PI()/2 and PI();     -- Q2\r\nupdate vat3.v3_vejnavnkoor set offset_x = -1*cos(angle_raw \u002B 0.5*PI()), offset_y = -1.0*sin(angle_raw \u002B 0.5*PI()) where angle_raw between PI() and 1.5*PI();   -- Q3\r\nupdate vat3.v3_vejnavnkoor set offset_x = 1*cos(angle_raw \u002B 0.5*PI()), offset_y = 1.0*sin(angle_raw \u002B 0.5*PI()) where angle_raw between 1.5*PI() and 2*PI(); -- Q4\r\n\r\nCREATE INDEX IF NOT EXISTS vejnavn_label_idx ON vat3.v3_vejnavnkoor using gist (label);\r\n"
      },
      "portPlacements": {
        "I:In": "Bottom",
        "O:Success": "Top",
        "O:Fail": "Left"
      },
      "flippedPortSides": [
        "Right"
      ]
    },
    {
      "id": "5a70bd38-26f3-4644-8d93-5a6550dcae2a",
