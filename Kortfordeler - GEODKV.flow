    {
      "id": "c538565c-12ad-4a90-b815-8c930fc30245",
      "name": "Calc Center of Point",
      "category": "Module",
      "nodeType": "ExecuteSQL",
      "x": 1301.044444444462,
      "y": 774.3555555555906,
      "width": 217.20000000000414,
      "height": 92,
      "executionMode": "Enabled",
      "settings": {
        "CommandTimeout": "0",
        "ConnectionString": "\u00A4[DafDataDB]\u00A4",
        "DBMS": "Postgres",
        "ExecuteEachLine": "False",
        "FilePath": "",
        "InTransaction": "False",
        "MaxRows": "0",
        "QueryType": "NonQuery",
        "ResultVariable": "",
        "SQL": "ALTER TABLE \u00A4{KF3_Schema}\u00A4.\u00A4{tablename,L}\u00A4 ALTER COLUMN sys_label SET STORAGE MAIN;\r\nUPDATE \u00A4{KF3_Schema}\u00A4.\u00A4{tablename,L}\u00A4 AS t -- point\r\nset sys_label = ST_Centroid (ST_Multi (geometri)) \r\nWHERE t.geometri IS NOT null AND t.sys_label IS NULL;"
      },
      "portPlacements": {
        "O:Success": "Top",
        "I:In": "Bottom"
      },
