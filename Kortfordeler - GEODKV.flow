      },
      "flippedPortSides": []
    },
    {
      "id": "3f6643c4-129b-4c01-b3c0-0a91456982ea",
      "name": "Calc Center of Linestring",
      "category": "Module",
      "nodeType": "ExecuteSQL",
      "x": 835.0000000000248,
      "y": 764.3333333333635,
      "width": 217.20000000000414,
      "height": 92,
      "executionMode": "Enabled",
      "settings": {
        "CommandTimeout": "0",
        "ConnectionString": "\u00A4[DafDataDB]\u00A4",
        "DBMS": "Postgres",
        "ExecuteEachLine": "False",
        "FilePath": "",
        "InTransaction": "False",
        "MaxRows": "0",
        "QueryType": "NonQuery",
        "ResultVariable": "",
        "SQL": "ALTER TABLE \u00A4{KF3_Schema}\u00A4.\u00A4{tablename,L}\u00A4 ALTER COLUMN sys_label SET STORAGE MAIN;\r\nUPDATE \u00A4{KF3_Schema}\u00A4.\u00A4{tablename,L}\u00A4 AS t  -- line\r\nSET sys_label = (SELECT ST_Force2D(ST_LineInterpolatePoint(d.geom, 0.5)) \r\n    FROM ST_Dump(ST_CollectionExtract(t.geometri, 2)) AS d WHERE ST_GeometryType(d.geom) = \u0027ST_LineString\u0027 ORDER BY ST_Length(d.geom) DESC LIMIT 1)\r\nWHERE t.geometri IS NOT NULL AND t.sys_label IS NULL;\r\n"
      },
      "portPlacements": {
        "O:Success": "Top",
        "I:In": "Bottom"
      },
      "flippedPortSides": [
        "Top"
      ]
    },
    {
      "id": "99123239-30ff-4f2e-9af7-ffc52c16580e",
      "name": "IF ST_MultiPolygon",
      "category": "Module",
      "nodeType": "IF_Then_Else",
      "x": 1078.2666666666819,
      "y": 932.1555555555872,
      "width": 200,
      "height": 102,
      "executionMode": "Enabled",
      "settings": {
        "Expression": "\u0022\u00A4{FeatureType}\u00A4\u0022 == \u0022ST_MultiPolygon\u0022 or \u0022\u00A4{FeatureType}\u00A4\u0022 == \u0022ST_Polygon\u0022"
      },
      "portPlacements": {
        "O:True": "Top"
      },
      "flippedPortSides": []
    },
    {
      "id": "4e53adec-a6f6-421b-96c6-113362aea2ef",
      "name": "Calc Center of Polygon",
      "category": "Module",
      "nodeType": "ExecuteSQL",
      "x": 1064.2666666666817,
      "y": 767.3111111111469,
      "width": 217.20000000000414,
      "height": 92,
      "executionMode": "Enabled",
      "settings": {
        "CommandTimeout": "0",
        "ConnectionString": "\u00A4[DafDataDB]\u00A4",
        "DBMS": "Postgres",
        "ExecuteEachLine": "False",
        "FilePath": "",
        "InTransaction": "False",
        "MaxRows": "0",
        "QueryType": "NonQuery",
        "ResultVariable": "",
        "SQL": "ALTER TABLE \u00A4{KF3_Schema}\u00A4.\u00A4{tablename,L}\u00A4 ALTER COLUMN sys_label SET STORAGE MAIN;\r\nUPDATE \u00A4{KF3_Schema}\u00A4.\u00A4{tablename,L}\u00A4 AS t  -- poly\r\nSET sys_label = ST_Force2D((ST_MaximumInscribedCircle(t.geometri)).center)\r\nWHERE t.geometri IS NOT NULL AND t.sys_label IS NULL;"
      },
      "portPlacements": {
        "O:Success": "Top",
        "I:In": "Bottom"
      },
      "flippedPortSides": [
        "Top"
      ]
    },
