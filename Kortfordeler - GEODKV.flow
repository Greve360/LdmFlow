        "MaxRows": "0",
        "QueryType": "NonQuery",
        "ResultVariable": "",
        "SQL": "ALTER TABLE \u00A4{KF3_Schema}\u00A4.v3_adresse ADD COLUMN IF NOT EXISTS sys_label public.geometry(Point, 25832);\r\n\r\nALTER TABLE \u00A4{KF3_Schema}\u00A4.v3_adresse ALTER COLUMN sys_label SET STORAGE MAIN;\r\nUPDATE \u00A4{KF3_Schema}\u00A4.v3_adresse AS t  -- line\r\nSET sys_label = (SELECT ST_Force2D(ST_LineInterpolatePoint(d.geom, 0.5)) \r\n    FROM ST_Dump(ST_CollectionExtract(t.geometri, 2)) AS d WHERE ST_GeometryType(d.geom) = \u0027ST_LineString\u0027 ORDER BY ST_Length(d.geom) DESC LIMIT 1)\r\nWHERE t.geometri IS NOT NULL AND t.sys_label IS NULL;\r\n"
