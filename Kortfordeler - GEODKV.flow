    {
      "id": "454a6693-6f34-4698-af42-8049ae49ac9a",
      "name": "Calc Center VAT Postdistrikt",
      "category": "Module",
      "nodeType": "ExecuteSQL",
      "x": 740.8000000000008,
      "y": 1099.200000000005,
      "width": 234.00000000000364,
      "height": 92,
      "executionMode": "Enabled",
      "settings": {
        "CommandTimeout": "0",
        "ConnectionString": "\u00A4[DafDataDB]\u00A4",
        "DBMS": "Postgres",
        "ExecuteEachLine": "False",
        "FilePath": "",
        "InTransaction": "False",
        "MaxRows": "0",
        "QueryType": "NonQuery",
        "ResultVariable": "",
        "SQL": "ALTER TABLE \u00A4{KF3_Schema}\u00A4.v3_postdistrikt ADD COLUMN IF NOT EXISTS sys_label public.geometry(Point, 25832);\r\n\r\nALTER TABLE \u00A4{KF3_Schema}\u00A4.v3_postdistrikt ALTER COLUMN sys_label SET STORAGE MAIN;\r\nUPDATE \u00A4{KF3_Schema}\u00A4.v3_postdistrikt AS t  -- poly\r\nSET sys_label = ST_Force2D((ST_MaximumInscribedCircle(t.geometri)).center)\r\nWHERE t.geometri IS NOT NULL AND t.sys_label IS NULL;"
      },
      "portPlacements": {},
      "flippedPortSides": [
        "Top"
      ]
    },
