        "Query": "{\u0022exists\u0022:{\u0022field\u0022:\u0022VrproduktionsEnhed\u0022}}",
        "PageSize": "3000",
        "OutputFolder": "\u00A4{CvrRawFolder}\u00A4\\ProduktionsEnhed",
        "FilePrefix": "penhed",
