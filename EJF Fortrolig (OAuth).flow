    {
      "id": "03e5f66b-d57a-47eb-9c89-afc056d141b0",
      "name": "Sql Iterator",
      "category": "Module",
      "nodeType": "SqlIterator",
      "x": 405,
      "y": 262,
      "width": 200,
      "height": 102,
      "executionMode": "Enabled",
      "settings": {
        "ConnectionString": "\u00A4[DdmSysDb]\u00A4",
        "DBMS": "MSSQL",
        "MaxParallelism": "4",
        "Mode": "Sequential",
        "ResultType": "Recordset",
        "Sql": "select \r\n\tentityName,generationNumber,fileName\r\nfrom workflow.DafFiles2\r\nwhere containedFileFormat = \u0027json\u0027\r\nand typeOfDownload = \u0027TotalDownload\u0027\r\nand municipalityCode is null\r\nand generationNumber =(\r\n    select max(generationNumber)\r\n    from workflow.DafFiles2\r\n    where containedFileFormat = \u0027json\u0027\r\n    and typeOfDownload = \u0027TotalDownload\u0027\r\n    and municipalityCode is null)",
        "SqlTimeout": "0"
      },
      "portPlacements": {
        "O:Item": "Left",
        "I:In": "Top",
        "I:LoopBack": "Right"
      },
      "flippedPortSides": []
