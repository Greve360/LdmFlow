    {
      "id": "e3ed1c69-db09-43af-9e6d-ba7c7f3683fa",
      "name": "Sql Iterator",
      "category": "Module",
      "nodeType": "SqlIterator",
      "x": 61,
      "y": 373,
      "width": 200,
      "height": 102,
      "executionMode": "Enabled",
      "settings": {
        "ConnectionString": "\u00A4[LdmSystemDB]\u00A4",
        "DBMS": "MSSQL",
        "MaxParallelism": "4",
        "Mode": "Sequential",
        "ResultType": "Recordset",
        "Sql": "select T.tablename, R.HarvestSchema from [workflow].[MetaTable] T \r\n  inner join [workflow].[MetaRegister] R on R.RegisterName = T.RegisterName \r\nwhere R.RegisterName = \u0027\u00A4{PickedRegister}\u00A4\u0027 and T.Active=1",
        "SqlTimeout": ""
      },
