    {
      "id": "e3ed1c69-db09-43af-9e6d-ba7c7f3683fa",
      "name": "Sql Iterator",
      "category": "Module",
      "nodeType": "SqlIterator",
      "x": 88.10000000000002,
      "y": 606.5600000000001,
      "width": 200,
      "height": 102,
      "executionMode": "Enabled",
      "settings": {
        "ConnectionString": "\u00A4[LdmSysDb]\u00A4",
        "DBMS": "MSSQL",
        "MaxParallelism": "20",
        "Mode": "Parallel",
        "ResultType": "Recordset",
        "Sql": "select R.RegisterName, R.HarvestSchema, T.TableName, R.GetFeatureEndpoint from [workflow].[MetaTable] T \r\n  inner join [workflow].[MetaRegister] R on R.RegisterName = T.RegisterName \r\nwhere (R.RegisterName = \u0027\u00A4{PickedRegister}\u00A4\u0027  or \u0027\u00A4{PickedRegister,U}\u00A4\u0027=\u0027ALL\u0027)\r\n  and R.RegisterType = \u0027WFS\u0027\r\n  and T.Active=1 \r\n  and (T.TableName = \u0027\u00A4{SingleTable}\u00A4\u0027 or \u00A4{SingleTable,#}\u00A4=0)\r\n  order by T.HarvestTimestamp asc",
        "SqlTimeout": ""
      },
      "portPlacements": {
        "O:Item": "Bottom",
        "I:In": "Top",
        "I:LoopBack": "Right"
      },
      "flippedPortSides": []
    },
