        "DBMS": "MSSQL",
        "MaxParallelism": "20",
        "Mode": "Parallel",
        "ResultType": "Recordset",
        "Sql": "select T.tablename, R.HarvestSchema from [workflow].[MetaTable] T \r\n  inner join [workflow].[MetaRegister] R on R.RegisterName = T.RegisterName \r\nwhere R.RegisterName = \u0027\u00A4{PickedRegister}\u00A4\u0027\r\n  and T.Active=1 \r\n  and (T.TableName = \u0027\u00A4{SingleTable}\u00A4\u0027 or \u00A4{SingleTable,#}\u00A4=0)",
        "SqlTimeout": ""
      },
