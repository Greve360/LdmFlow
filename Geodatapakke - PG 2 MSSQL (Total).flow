    {
      "id": "e16365e1-6129-4695-a9d0-63537d4d9f95",
      "name": "Loop PG Tables",
      "category": "Module",
      "nodeType": "SqlIterator",
      "x": 43,
      "y": 387,
      "width": 190,
      "height": 92,
      "executionMode": "Enabled",
      "settings": {
        "ConnectionString": "\u00A4[GrunddataDB]\u00A4",
        "DBMS": "Postgres",
        "Sql": "select schemaname, tablename from pg_tables where schemaname not in (\u0027pg_catalog\u0027,\u0027public\u0027, \u0027dai\u0027, \u0027information_schema\u0027) order by schemaname, tablename",
        "ResultType": "Recordset",
        "Mode": "Sequential",
        "MaxParallelism": "10",
        "SqlTimeout": ""
      },
      "portPlacements": {
        "I:In": "Top",
        "I:LoopBack": "Bottom"
