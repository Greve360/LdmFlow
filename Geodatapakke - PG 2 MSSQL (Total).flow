        "MaxParallelism": "10",
        "Mode": "Sequential",
        "ResultType": "Recordset",
        "Sql": "select R.HarvestSchema,T.TableName from workflow.MetaTable T\r\ninner join workflow.MetaRegister R on R.RegisterName = T.RegisterName\r\nwhere R.RegisterName = \u0027GD_plan\u0027 order by T.TableName",
