      "settings": {
        "ConnectionString": "\u00A4[MSSQL_Sandbox]\u00A4",
        "DBMS": "MSSQL",
        "FilePath": "",
        "SQL": "IF OBJECT_ID(\u0027\u00A4{schemaname}\u00A4.\u00A4{tablename}\u00A4\u0027, \u0027U\u0027) IS NOT NULL \r\n  DROP TABLE \u00A4{schemaname}\u00A4.\u00A4{tablename}\u00A4; \r\n"
