    {
      "id": "e16365e1-6129-4695-a9d0-63537d4d9f95",
      "name": "Loop GD Tables",
      "category": "Module",
      "nodeType": "SqlIterator",
      "x": 642.3333333333287,
      "y": 180.33333333333223,
      "width": 190,
      "height": 92,
      "executionMode": "Enabled",
      "settings": {
        "ConnectionString": "\u00A4[DdmSysDb]\u00A4",
        "DBMS": "MSSQL",
        "MaxParallelism": "10",
        "Mode": "Sequential",
        "ResultType": "Recordset",
        "Sql": "select R.HarvestSchema, R.TargetSchema, T.TableName \r\nfrom workflow.MetaTable T\r\ninner join workflow.MetaRegister R on R.RegisterName = T.RegisterName\r\nwhere (R.RegisterName = \u0027\u00A4{SourceRegister}\u00A4\u0027 or \u00A4{SourceRegister,#}\u00A4 = 0)\r\n and R.RegisterType=\u0027WFS\u0027\r\n and R.Active=1\r\n and T.Active=1\r\norder by R.RegisterName, T.TableName",
        "SqlTimeout": ""
      },
      "portPlacements": {
        "I:LoopBack": "Bottom"
      },
      "flippedPortSides": []
    },
