      "name": "OGR2OGR (external)",
      "category": "Module",
      "nodeType": "OGR2OGRExternal",
      "x": 903,
      "y": 873,
      "width": 200,
      "height": 102,
      "executionMode": "Enabled",
      "settings": {
        "AdditionalArguments": "-makevalid -lco SCHEMA=\u00A4{DestinationSchema}\u00A4 -lco \u0022SPATIAL_INDEX=NO\u0022 -lco \u0022GEOMETRY_NAME=Geometri\u0022 -lco \u0022OVERWRITE=YES\u0022 -lco \u0022LAUNDER=NO\u0022 --config MSSQLSPATIAL_USE_GEOMETRY_COLUMNS NO",
        "AdditionalEnvironment": "",
        "Destination": "\u00A4[RegisterWorkOGR]\u00A4",
        "GeometryType": "",
        "LayerName": "\u00A4{tablename}\u00A4",
        "Mode": "Overwrite",
        "OgrExecutable": "\u00A4[GdalSdkRoot]\u00A4bin\\gdal\\apps\\ogr2ogr.exe",
        "OutputFormat": "MSSQLSpatial",
        "SdkRoot": "\u00A4[GdalSdkRoot]\u00A4",
        "SelectFields": "",
        "Source": "\u00A4[GrunddataOGR]\u00A4",
        "SourceSrs": "",
        "Sql": "select * from \u00A4{schemaname}\u00A4.\u00A4{tablename}\u00A4 \u00A4{RowLimiter}\u00A4",
        "TargetSrs": "",
        "Where": "",
        "XsdFile": "",
        "XsdTableName": ""
      },
      "portPlacements": {},
      "flippedPortSides": []
    },
