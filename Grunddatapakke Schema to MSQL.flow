      "id": "3f1dd131-65c9-44f8-8435-7cf0e4ebd3e4",
      "name": "Get SQL Fields",
      "category": "Module",
      "nodeType": "GetSqlFields",
      "x": 505.89506172839515,
      "y": 223.67901234567773,
      "width": 200,
      "height": 102,
      "executionMode": "Enabled",
      "settings": {
        "ConnectionString": "\u00A4[GrunddataDB]\u00A4",
        "DBMS": "Postgres",
        "GeometryOperations": "ST_MakeValid",
        "MakeGeometryBinary": "Yes",
        "Schema": "\u00A4{PostgresSchema}\u00A4",
        "Table": "\u00A4{tablename}\u00A4"
      },
      "portPlacements": {
        "I:In": "Top",
        "O:Out": "Bottom"
      },
      "flippedPortSides": []
    },
    {
      "id": "77252a7b-75b6-4083-9598-606e20ed8050",
      "name": "Loop PG Tables",
      "category": "Module",
      "nodeType": "SqlIterator",
      "x": 533.5,
      "y": 42,
      "width": 190,
      "height": 92,
      "executionMode": "Enabled",
      "settings": {
        "ConnectionString": "\u00A4[GrunddataDB]\u00A4",
        "DBMS": "Postgres",
        "MaxParallelism": "10",
        "Mode": "Parallel",
        "ResultType": "Recordset",
        "Sql": "select schemaname, tablename from pg_tables where schemaname ilike \u0027\u00A4{PostgresSchema}\u00A4\u0027 order by tablename",
        "SqlTimeout": ""
      },
      "portPlacements": {
        "O:Item": "Bottom",
        "I:LoopBack": "Right"
      },
      "flippedPortSides": [
        "Top"
      ]
    },
    {
      "id": "a3ef69d6-db8e-49cd-9674-af6e1b0bb3ed",
      "name": "Display",
      "category": "Module",
      "nodeType": "Display",
      "x": 463.3950617283955,
      "y": 378.6790123456775,
      "width": 301,
      "height": 108,
      "executionMode": "Enabled",
      "settings": {
        "Text": "\u00A4{schemaname}\u00A4.\u00A4{tablename}\u00A4\r\n\u00A4{GeometryColumn}\u00A4"
      },
      "portPlacements": {
        "I:In": "Top",
        "O:Out": "Bottom"
      },
      "flippedPortSides": []
    },
