      },
      "flippedPortSides": []
    },
    {
      "id": "ecc6931b-7fab-4147-89f0-7749a308ed4a",
      "name": "OGR2OGR (external)",
      "category": "Module",
      "nodeType": "OGR2OGRExternal",
      "x": 414,
      "y": 424,
      "width": 200,
      "height": 102,
      "executionMode": "Enabled",
      "settings": {
        "AdditionalArguments": "-makevalid -lco SCHEMA=\u00A4{targetschema}\u00A4 -lco \u0022SPATIAL_INDEX=NO\u0022 -lco \u0022GEOMETRY_NAME=Geometri\u0022 -lco \u0022OVERWRITE=YES\u0022 -lco \u0022LAUNDER=NO\u0022 --config MSSQLSPATIAL_USE_GEOMETRY_COLUMNS NO -LCO \u0022SPATIAL_INDEX=NO\u0022",
        "AdditionalEnvironment": "",
        "Destination": "\u00A4[RegisterWorkOGR]\u00A4",
        "DestinationConnectionString": "",
        "DestinationTable": "",
        "GeometryType": "",
        "LayerName": "\u00A4{PgTableName,L}\u00A4",
        "Mode": "Overwrite",
        "OgrExecutable": "\u00A4[GdalSdkRoot]\u00A4bin\\gdal\\apps\\ogr2ogr.exe",
        "OutputFormat": "MSSQLSpatial",
        "ReduceNvarCharMax": "",
        "SdkRoot": "\u00A4[GdalSdkRoot]\u00A4",
        "SelectFields": "",
        "Source": "\u00A4[GrunddataOGR]\u00A4",
        "SourceSrs": "",
        "Sql": "select * from \u00A4{harvestSchema}\u00A4.\u00A4{PgTableName,L}\u00A4 \u00A4{RowLimiter}\u00A4",
        "TargetSrs": "",
        "Where": "",
        "XsdFile": "",
        "XsdTableName": ""
      },
      "portPlacements": {
        "O:Success": "Top",
        "I:In": "Bottom"
      },
      "flippedPortSides": []
    },
    {
      "id": "814546d3-c626-4487-8967-83c83703ae43",
      "name": "Start ALL GD",
      "category": "Module",
      "nodeType": "Start",
      "x": 20,
      "y": 124,
      "width": 200,
      "height": 102,
      "executionMode": "Enabled",
      "settings": {
        "DestinationMSSQL": "\u00A4[RegisterWorkDB]\u00A4",
        "PostgresSchema": "dai01",
        "RowLimiter": ""
      },
      "portPlacements": {},
      "flippedPortSides": []
    },
    {
      "id": "06d8fff9-0ae1-42ac-a45b-bbce3dfaa18d",
      "name": "Stream Edit",
      "category": "Module",
      "nodeType": "StreamEdit",
      "x": 683,
      "y": 253,
      "width": 190,
      "height": 92,
      "executionMode": "Enabled",
      "settings": {
        "Instructions": "s/^[^:]*://\r\ns/[^a-z0-9_]/_/g\r\ns/_{2,}/_/g\r\ns/^_//; s/_$//",
        "OutputVariable": "PgTableName",
        "Source": "\u00A4{tablename}\u00A4"
      },
      "portPlacements": {
        "O:Out": "Bottom",
        "I:In": "Top"
      },
      "flippedPortSides": []
    },
    {
      "id": "83bc8c75-d392-43fa-9c9a-704845a00014",
      "name": "Update PublishTimestamp",
      "category": "Module",
      "nodeType": "ExecuteSQL",
      "x": 393,
      "y": 246,
      "width": 232,
      "height": 103,
      "executionMode": "Enabled",
      "settings": {
        "CommandTimeout": "0",
        "ConnectionString": "\u00A4[DdmSysDb]\u00A4",
        "DBMS": "MSSQL",
        "ExecuteEachLine": "False",
        "FilePath": "",
        "InTransaction": "False",
        "MaxRows": "0",
        "QueryType": "NonQuery",
        "ResultVariable": "",
        "SQL": "update workflow.MetaTable \r\nset PublishTimestamp = GetDate()\r\nwhere RegisterName = \u0027\u00A4{RegisterName}\u00A4\u0027 and TableName = \u0027\u00A4{TableName}\u00A4\u0027"
      },
      "portPlacements": {
        "I:In": "Bottom",
        "O:Success": "Top"
      },
      "flippedPortSides": []
    }
  ],
