    {
      "id": "3f1dd131-65c9-44f8-8435-7cf0e4ebd3e4",
      "name": "Get SQL Fields",
      "category": "Module",
      "nodeType": "GetSqlFields",
      "x": 698.8950617283951,
      "y": 424.67901234567773,
      "width": 200,
      "height": 102,
      "executionMode": "Enabled",
      "settings": {
        "ConnectionString": "\u00A4[GrunddataDB]\u00A4",
        "DBMS": "Postgres",
        "GeometryOperations": "ST_MakeValid",
        "MakeGeometryBinary": "Yes",
        "Schema": "\u00A4{harvestschema}\u00A4",
        "Table": "\u00A4{PgTableName,L}\u00A4"
      },
      "portPlacements": {
        "I:In": "Top",
        "O:Out": "Bottom"
      },
      "flippedPortSides": []
    },
    {
      "id": "77252a7b-75b6-4083-9598-606e20ed8050",
      "name": "Loop PG Tables",
      "category": "Module",
      "nodeType": "SqlIterator",
      "x": 534.5,
      "y": 38,
      "width": 190,
      "height": 92,
      "executionMode": "Enabled",
      "settings": {
        "ConnectionString": "\u00A4[DdmSysDb]\u00A4",
        "DBMS": "MSSQL",
        "MaxParallelism": "10",
        "Mode": "Parallel",
        "ResultType": "Recordset",
        "Sql": "select \r\nR.RegisterName as RegisterName,\r\nR.harvestSchema as harvestschema,\r\nR.targetschema as targetschema, \r\nT.TableName as tablename \r\nfrom workflow.MetaRegister R\r\ninner join workflow.MetaTable T on R.RegisterName = T.RegisterName\r\nwhere R.RegisterType = \u0027WFS\u0027\r\nand T.HarvestTimestamp \u003E T.PublishTimestamp\r\nand (R.harvestSchema like \u0027\u00A4{PostgresSchema}\u00A4\u0027 or \u00A4{PostgresSchema,#}\u00A4 = 0)\r\nand R.Active = 1 and T.Active = 1\r\norder by R.targetschema desc, T.TableName ",
        "SqlTimeout": ""
      },
      "portPlacements": {
        "O:Item": "Bottom",
        "I:LoopBack": "Bottom"
      },
      "flippedPortSides": [
        "Top",
        "Bottom"
      ]
    },
    {
      "id": "a3ef69d6-db8e-49cd-9674-af6e1b0bb3ed",
      "name": "Display",
      "category": "Module",
      "nodeType": "Display",
      "x": 695.3950617283955,
      "y": 610.6790123456775,
      "width": 301,
      "height": 108,
      "executionMode": "Enabled",
      "settings": {
        "Text": "\u00A4{harvestSchema}\u00A4.\u00A4{PgTableName,L}\u00A4\r\n\u00A4{GeometryColumn}\u00A4"
      },
      "portPlacements": {
        "I:In": "Top",
        "O:Out": "Bottom"
      },
      "flippedPortSides": []
    },
    {
      "id": "b7ed90e4-8ec1-4f1b-bbc5-d1e4dec909d5",
      "name": "Ensure Schema",
      "category": "Module",
      "nodeType": "EnsureSchema",
      "x": 560.895061728396,
      "y": 832.6790123456768,
      "width": 200,
      "height": 102,
      "executionMode": "Enabled",
      "settings": {
        "ConnectionString": "\u00A4{DestinationMSSQL}\u00A4",
        "DBMS": "MSSQL",
        "SchemaName": "\u00A4{targetschema}\u00A4"
      },
      "portPlacements": {
        "I:In": "Top",
        "O:Success": "Top"
      },
      "flippedPortSides": [
        "Top"
      ]
    },
    {
      "id": "975273e1-4cc1-4e30-a024-8dd99a09b6f7",
