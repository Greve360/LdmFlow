    {
      "id": "44cd293b-2b02-466e-92de-cc6d812cacb2",
      "name": "ArcPython",
      "category": "Module",
      "nodeType": "ArcPython",
      "x": 492,
      "y": 183,
      "width": 200,
      "height": 102,
      "executionMode": "Enabled",
      "settings": {
        "PythonExecutable": "",
        "Script": "import arcpy\r\nimport csv\r\nimport os\r\nimport pyodbc\r\n\r\ndef check_tables(gdb_path, servicename):\r\n    arcpy.env.workspace = gdb_path\r\n    print(f\u0022Listing features\u0022)\r\n    polygon_tables = arcpy.ListFeatureClasses(\u0022*\u0022, \u0022Polygon\u0022)    \r\n    print(f\u0022  ..done\u0022)\r\n\r\n    arc_err_gdb = r\u0022F:\\\\Data\\\\ArcGIS\\\\LocalSDE.gdb\u0022\r\n\r\n    # Check if any tables exist in the geodatabase\r\n    arcpy.env.workspace = arc_err_gdb\r\n    tables_exist = bool(arcpy.ListTables())\r\n\r\n    # Choose file mode based on table existence\r\n    file_mode = \u0022a\u0022 if tables_exist else \u0022w\u0022\r\n\r\n    # Open the text file for writing\r\n    with open(f\u0022f:\\\\fix_{servicename}_gml.sql\u0022, file_mode) as sql_file:\r\n        for table in polygon_tables:\r\n            try:\r\n                # if table.split(\u0027.\u0027)[-1] != \u0022EstimeretBebygPct\u0022:\r\n                #     print(f\u0022Skipping table (not \u0027EstimeretBebygPct\u0027): {table}\u0022)\r\n                #     continue\r\n\r\n                if \u0022oversvoemerosion\u0022 in table:\r\n                    print(f\u0022Skipping table (contains \u0027oversvoemerosion\u0027): {table}\u0022)\r\n                    continue\r\n\r\n                if \u0022_lulc_map_poly\u0022 in table:  # Known issues with this table\r\n                    print(f\u0022Skipping table (contains \u0027_lulc_map_poly\u0027): {table}\u0022)\r\n                    continue\r\n\r\n                if \u0022vp3e2022_lulc_map_poly\u0022 in table:  # Known issues with this table\r\n                    print(f\u0022Skipping table: {table}\u0022)\r\n                    continue\r\n\r\n                print(f\u0022Testing: {table}\u0022)\r\n                table_wo_schema = table.split(\u0027.\u0027)[-1]\r\n                the_out_table = f\u0022{arc_err_gdb}\\\\{table_wo_schema}_err\u0022\r\n\r\n                if arcpy.Exists(the_out_table):\r\n                    print(f\u0022Skipping {the_out_table}: already exists.\u0022)\r\n                    continue  # or return, depending on your loop/structure\r\n\r\n\r\n                arcpy.management.CheckGeometry(\r\n                    in_features=f\u0022{gdb_path}\\\\{table}\u0022,\r\n                    out_table=the_out_table,\r\n                    validation_method=\u0022ESRI\u0022\r\n                )\r\n                print(f\u0022Tested: {table}\u0022)\r\n            except Exception as e:\r\n                print(f\u0022Exception: {table}: {e}\u0022)\r\n                \r\nif __name__ == \u0022__main__\u0022:\r\n    print(f\u0022Start\u0022)\r\n    check_tables(\u0022F:\\\\Data\\\\ArcGIS\\\\LocalSandbox\\\\SQLServer-localhost-SandboxSDE.sde\u0022, \u0022mat\u0022)\r\n    print(f\u0022Done\u0022)\r\n"
      },
